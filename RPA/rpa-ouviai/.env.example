# Copie para .env e preencha só o que for usar. NUNCA versione o .env.
# Todas as integrações são opcionais: sem elas o robô segue pelo caminho seguro.

# Modo de execução
ROBO_OFFLINE=false
ROBO_DEMO_FALHAS=false

# Eventos do OuviAí vindos da API do grupo (FastAPI). Sem isso, lê dados/entrada/eventos_*.csv
EVENTOS_API_URL=

# LLM opcional para o resumo do cuidador (qualquer API compatível com OpenAI)
# Groq gratuito: https://api.groq.com/openai/v1  |  Ollama local: http://localhost:11434/v1
LLM_API_URL=
LLM_API_KEY=
LLM_MODELO=llama-3.1-8b-instant

# E-mail. Sem SMTP_HOST o e-mail é salvo em saida/caixa_de_saida/*.eml
SMTP_HOST=
SMTP_PORTA=587
SMTP_USUARIO=
SMTP_SENHA=
EMAIL_REMETENTE=robo-ouviai@example.org
EMAIL_CUIDADOR=cuidador@example.org
